// MonteCalc for Excel - resources of the .xll: the MC FLO logo and the version information
#include <winver.h>
#include "montecalc_version.h"

// icon 1: Windows Explorer (file properties), the MonteCalc windows, dialogs and messages
1 ICON "montecalc.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MONTECALC_VERSION_NUM
PRODUCTVERSION MONTECALC_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MonteCalc"
            VALUE "FileDescription", "MonteCalc - Monte Carlo simulation for Microsoft Excel (MC FLO)"
            VALUE "FileVersion", MONTECALC_VERSION_STR
            VALUE "InternalName", "MonteCalc"
            VALUE "OriginalFilename", "MonteCalc.xll"
            VALUE "ProductName", "MonteCalc (MC FLO)"
            VALUE "ProductVersion", MONTECALC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
