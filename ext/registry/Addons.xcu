<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.montecalc.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">MonteCalc</value></prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="m00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Run</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Run simulation...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Settings</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Simulation settings...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Variables</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Show variables</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Lock</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Lock / unlock input in selected cell</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m05" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m06" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Report</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Create result workbook</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m07" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Replay</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Analyse iteration...</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m08" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Expected</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Show expected values</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m09" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Preview</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Toggle random preview (F9 draws)</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m10" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Reset</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Reset results</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
          <node oor:name="m11" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m12" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:About</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">About MonteCalc</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="OfficeToolBar">
      <node oor:name="org.montecalc.toolbar" oor:op="replace">
        <node oor:name="t00" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Run</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Run simulation</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="t01" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Settings</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Settings</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="t02" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Variables</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Variables</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="t03" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Report</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Results</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
        <node oor:name="t04" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>org.montecalc:Reset</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Reset</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
